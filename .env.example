VITE_POSTHOG_KEY=phc_your_public_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_LINE_CHANNEL_ID=
# Public UX switch; off restores login-first. No change to backend eligibility or invitations.
VITE_CHECK_FIRST_ONBOARDING=true

# Server-side Gemini chat (never prefix these with VITE_ or NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used only after a provider 5xx or per-attempt timeout. Set empty to disable model failover.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
CAMELLIA_GEMINI_CHAT_ENABLED=false
# Production needs a separate deliberate approval after Privacy/operations review.
CAMELLIA_GEMINI_CHAT_PRODUCTION_APPROVED=false

# Phase 1 server-only storage (never commit real credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=
CAMELLIA_SHARED_RATE_LIMIT_REQUIRED=false
CAMELLIA_CHAT_RATE_USER=20
CAMELLIA_CHAT_RATE_GLOBAL=1000
CAMELLIA_CHAT_RATE_WINDOW_SECONDS=300
GEMINI_DATA_POLICY=unknown
CAMELLIA_CIRCLE_SIGNING_SECRET=
CAMELLIA_CIRCLE_ENABLED=false
# Public feature switch only; no secret. Enable after release acceptance.
VITE_CIRCLE_ENABLED=false

# Place: enable Preview only after verified operator review
CAMELLIA_PLACE_ENABLED=false
VITE_PLACE_ENABLED=false

# Choice / Place release; off restores the prior Check-first entry.
VITE_CHOICE_ACTION_FLOW=true

# New Circle → Place integration: keep OFF until real listing and scoped operator acceptance.
VITE_CIRCLE_PLACE_LINKS_ENABLED=false
CAMELLIA_CIRCLE_PLACE_LINKS_ENABLED=false

# Stripe (Camellia Plus 500 JPY/month). Server only; never prefix with VITE_.
# Checkout also needs the operator approval document: node scripts/billing-config.mjs --approve <price_ID> "<name>"
CAMELLIA_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
CAMELLIA_APP_URL=https://camellia-beta.vercel.app

# Friend invitation campaign (also needs: node scripts/referral-config.mjs --start "<name>")
CAMELLIA_REFERRAL_ENABLED=false
VITE_REFERRAL_ENABLED=false

# Web Push notifications (keys: node scripts/vapid-keys.mjs; approve: node scripts/notification-config.mjs --start "<name>")
CAMELLIA_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel Cron sends Authorization: Bearer CRON_SECRET to /api/camellia/notification-cron (daily 12:00 JST)
CRON_SECRET=
CAMELLIA_PLACE_INTRODUCTION_BATCH=
