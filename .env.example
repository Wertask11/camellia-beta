VITE_POSTHOG_KEY=phc_your_public_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_LINE_CHANNEL_ID=

# Server-side Gemini chat (never prefix these with VITE_ or NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used only after a provider 5xx or per-attempt timeout. Set empty to disable model failover.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
CAMELLIA_GEMINI_CHAT_ENABLED=false
# Production needs a separate deliberate approval after Privacy/operations review.
CAMELLIA_GEMINI_CHAT_PRODUCTION_APPROVED=false

# Phase 1 server-only storage (never commit real credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=
CAMELLIA_SHARED_RATE_LIMIT_REQUIRED=false
CAMELLIA_CHAT_RATE_USER=20
CAMELLIA_CHAT_RATE_GLOBAL=1000
CAMELLIA_CHAT_RATE_WINDOW_SECONDS=300
GEMINI_DATA_POLICY=unknown
CAMELLIA_CIRCLE_SIGNING_SECRET=
CAMELLIA_CIRCLE_ENABLED=false
# Public feature switch only; no secret. Enable after release acceptance.
VITE_CIRCLE_ENABLED=false
